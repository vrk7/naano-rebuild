# Copy to .env.local and fill in. Never commit .env.local.

# --- Required -----------------------------------------------------------------
# Supabase project URL and anon key. Both are public: the anon key is inlined
# into the browser bundle by Next, and every table it can reach is behind RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS entirely. Server-only — used by the seed scripts, the engagement
# simulation, and the access-control tests. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional -----------------------------------------------------------------
# Turns a pasted website into a brand profile and three ICPs. Without it the
# provider reports itself unavailable and the brand writes its ICPs by hand;
# `atira.example` is a built-in fixture that needs no key at all.
GOOGLE_GENERATIVE_AI_API_KEY=

# Creates a demo login during `npm run db:seed:demo`. Omit both and the demo
# data is seeded without any account attached to it.
SEED_DEMO_EMAIL=
SEED_DEMO_PASSWORD=
